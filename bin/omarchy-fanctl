#!/usr/bin/env bash
#
# omarchy-fanctl — privileged fan control helper for Framework laptops.
#
# The Framework 13 EC (cros_ec) exposes RPM and temperatures through hwmon
# sysfs, but no PWM control: /dev/cros_ec is root-only, so the fan duty is set
# with ectool (EC_CMD_PWM_SET_FAN_DUTY / EC_CMD_THERMAL_AUTO_FAN_CTRL). The
# shell plugin runs this helper through a sudoers whitelist that permits
# exactly `auto`, `manual 10..100`, `curve <preset>`, `curves`,
# `charge limit <stop> <start>` and `charge off` — nothing else executes as root.
#
# Every successful control command rewrites state.json (world-readable)
# recording the mode, the boot id, and the duty, so the plugin can read the
# real state without privileges. A boot id mismatch means the EC forgot a
# manual duty across a reboot: the reported mode falls back to automatic.
#
# Testing: OMARCHY_FANCTL_TEST_ROOT replaces /sys/class/hwmon,
# OMARCHY_FANCTL_STATE_DIR replaces the state directory, a fake `ectool` on
# PATH stands in for the real one, and OMARCHY_FANCTL_ALLOW_UNPRIVILEGED=1
# lifts the root check so the test suite can drive `auto`/`manual`, and
# OMARCHY_FANCTL_POWER_ROOT replaces /sys/class/power_supply.

set -euo pipefail

readonly PROTOCOL_VERSION=1
readonly DEFAULT_HWMON_ROOT=/sys/class/hwmon
readonly DEFAULT_POWER_ROOT=/sys/class/power_supply
readonly DEFAULT_STATE_DIR=/var/lib/omarchy-fanctl
readonly MIN_DUTY=10
readonly MAX_DUTY=100
readonly MIN_STOP=60
readonly MAX_STOP=99
readonly MIN_START=20

fail() {
  printf 'omarchy-fanctl: %s\n' "$*" >&2
  exit 1
}

hwmon_root() { printf '%s\n' "${OMARCHY_FANCTL_TEST_ROOT:-$DEFAULT_HWMON_ROOT}"; }
state_dir()  { printf '%s\n' "${OMARCHY_FANCTL_STATE_DIR:-$DEFAULT_STATE_DIR}"; }
state_file() { printf '%s/state.json\n' "$(state_dir)"; }

require_root() {
  if [[ ${EUID:-$(id -u)} -ne 0 && ${OMARCHY_FANCTL_ALLOW_UNPRIVILEGED:-} != 1 ]]; then
    fail "fan control requires root"
  fi
}

# Exactly one cros_ec hwmon device with a readable fan RPM input.
find_device() {
  local root name name_file device
  root=$(hwmon_root)
  for name_file in "$root"/hwmon*/name; do
    [[ -r $name_file ]] || continue
    IFS= read -r name < "$name_file" || continue
    [[ $name == cros_ec ]] || continue
    device=${name_file%/name}
    [[ -r $device/fan1_input ]] || continue
    printf '%s\n' "$device"
    return 0
  done
  return 1
}

read_number() {
  local value
  [[ -r $1 ]] || return 1
  IFS= read -r value < "$1" || return 1
  [[ $value =~ ^[0-9]+$ ]] || return 1
  printf '%s\n' "$value"
}

# The EC's CPU-labeled sensor (e.g. "cpu_f75303@4d"), in whole degrees C.
read_cpu_temp_c() {
  local device=$1 label_file label input millidegrees
  for label_file in "$device"/temp*_label; do
    [[ -r $label_file ]] || continue
    IFS= read -r label < "$label_file" || continue
    [[ ${label,,} == *cpu* ]] || continue
    input=${label_file%_label}_input
    millidegrees=$(read_number "$input") || continue
    printf '%d\n' "$(( (millidegrees + 500) / 1000 ))"
    return 0
  done
  return 1
}

boot_id() { cat /proc/sys/kernel/random/boot_id 2>/dev/null || printf 'unknown\n'; }

# The device's own thermal thresholds. The first time a curve is read or
# changed, `ectool thermalget` is captured (minus any offset a previous
# helper left applied) into thermal-baseline: "sensor warn high halt fan_off
# fan_max" rows. warn/high/halt are written back exactly as the EC reported
# them; the presets only shift fan_off and fan_max. The battery sensor (2)
# is never captured or touched — its halt threshold protects the pack.
baseline_file() { printf '%s/thermal-baseline\n' "$(state_dir)"; }

ensure_baseline() {
  local file text prior offset sid warn high halt off max rest rows=""
  file=$(baseline_file)
  [[ -s $file ]] && return 0
  command -v ectool >/dev/null 2>&1 || return 1
  text=$(ectool thermalget 2>/dev/null) || return 1
  prior=$(current_curve)
  offset=$(curve_offset "$prior") || offset=0
  while read -r sid warn high halt off max rest; do
    [[ $sid =~ ^[0-9]+$ && $warn =~ ^[0-9]+$ && $high =~ ^[0-9]+$ && $halt =~ ^[0-9]+$ \
       && $off =~ ^[0-9]+$ && $max =~ ^[0-9]+$ ]] || continue
    [[ $sid == 2 ]] && continue
    rows+="$sid $warn $high $halt $((off - offset)) $((max - offset))"$'\n'
  done <<< "$text"
  [[ -n $rows ]] || return 1
  mkdir -p -- "$(state_dir)"
  printf '%s' "$rows" > "$file.tmp"
  chmod 0644 "$file.tmp"
  mv -f "$file.tmp" "$file"
}

curve_offset() {
  case $1 in
    stock)  printf '0\n' ;;
    quiet)  printf '6\n' ;;
    silent) printf '12\n' ;;
    *)      return 1 ;;
  esac
}

# state.json is one line written by write_state; the mode and duty are picked
# out with fixed-string greps rather than a JSON parser so the helper has no
# dependencies beyond bash and ectool.
read_state_field() {
  local key=$1 text
  text=$(cat "$(state_file)" 2>/dev/null) || return 1
  printf '%s' "$text" | grep -o "\"$key\":[^,}]*" | head -1 | sed 's/^"[^"]*"://; s/"//g'
}

current_curve() {
  local c
  c=$(read_state_field curve || true)
  case $c in
    stock|quiet|silent) printf '%s\n' "$c" ;;
    *) printf 'stock\n' ;;
  esac
}

write_state() {
  local mode=$1 duty=$2 curve=${3:-$(current_curve)} file
  mkdir -p -- "$(state_dir)"
  file=$(state_file)
  printf '{"protocolVersion":%d,"mode":"%s","dutyPercent":%d,"curve":"%s","bootId":"%s","updated":%d}\n' \
    "$PROTOCOL_VERSION" "$mode" "$duty" "$curve" "$(boot_id)" "$(date +%s)" > "$file.tmp"
  chmod 0644 "$file.tmp"
  mv -f "$file.tmp" "$file"
}

run_ectool() {
  command -v ectool >/dev/null 2>&1 || fail "ectool is not installed (fw-ectool-git)"
  ectool "$@" || fail "ectool $* failed"
}

cmd_status() {
  local device rpm cpu_temp mode duty state_text
  if ! device=$(find_device); then
    printf '{"protocolVersion":%d,"available":false,"reason":"no cros_ec fan on this machine"}\n' "$PROTOCOL_VERSION"
    return 0
  fi
  rpm=$(read_number "$device/fan1_input") || rpm=0
  cpu_temp=$(read_cpu_temp_c "$device") || cpu_temp=-1

  mode=auto
  duty=0
  if state_text=$(cat "$(state_file)" 2>/dev/null); then
    if printf '%s' "$state_text" | grep -Fq "\"bootId\":\"$(boot_id)\""; then
      mode=$(read_state_field mode)
      [[ $mode == manual ]] || mode=auto
      duty=$(read_state_field dutyPercent)
      [[ $duty =~ ^[0-9]+$ ]] || duty=0
    fi
  fi

  printf '{"protocolVersion":%d,"available":true,"mode":"%s","dutyPercent":%d,"rpm":%d,"cpuTempC":%d}\n' \
    "$PROTOCOL_VERSION" "$mode" "$duty" "$rpm" "$cpu_temp"
}

cmd_auto() {
  require_root
  run_ectool autofanctrl >/dev/null
  write_state auto 0
  printf 'automatic fan control restored\n'
}

cmd_manual() {
  local duty=$1
  [[ $duty =~ ^[0-9]+$ ]] || fail "duty must be an integer percent"
  (( duty >= MIN_DUTY && duty <= MAX_DUTY )) || fail "duty must be between $MIN_DUTY and $MAX_DUTY"
  require_root
  run_ectool fanduty "$duty" >/dev/null
  write_state manual "$duty"
  printf 'fan duty set to %d%%\n' "$duty"
}

# Shift the EC's own automatic ramp, sensor by sensor, at stock
# warn/high/halt. The EC keeps every protection threshold; a full
# power-off resets the curve to stock.
cmd_curve() {
  local name=$1 offset sid warn high halt off max mode duty
  offset=$(curve_offset "$name") || fail "curve must be stock, quiet or silent"
  require_root
  ensure_baseline || fail "could not read the EC's thermal thresholds (ectool thermalget)"
  while read -r sid warn high halt off max; do
    run_ectool thermalset "$sid" "$warn" "$high" "$halt" "$((off + offset))" "$((max + offset))" >/dev/null
  done < "$(baseline_file)"
  mode=$(read_state_field mode || true)
  [[ $mode == manual ]] || mode=auto
  duty=$(read_state_field dutyPercent || true)
  [[ $duty =~ ^[0-9]+$ ]] || duty=0
  write_state "$mode" "$duty" "$name"
  printf 'automatic curve set to %s\n' "$name"
}

# Report which preset the EC is actually running, read from thermalget —
# the EC, not the state file, is the truth after a power-off.
cmd_curves() {
  local text name match offset sid warn high halt off max got_off got_max
  require_root
  ensure_baseline || { printf '{"protocolVersion":%d,"curve":"unknown"}\n' "$PROTOCOL_VERSION"; return 0; }
  text=$(ectool thermalget 2>/dev/null) || { printf '{"protocolVersion":%d,"curve":"unknown"}\n' "$PROTOCOL_VERSION"; return 0; }
  match=""
  for name in stock quiet silent; do
    offset=$(curve_offset "$name")
    match=$name
    while read -r sid warn high halt off max; do
      got_off=$(printf '%s' "$text" | awk -v sid="$sid" 'NR > 1 && $1 == sid { print $5; exit }')
      got_max=$(printf '%s' "$text" | awk -v sid="$sid" 'NR > 1 && $1 == sid { print $6; exit }')
      [[ $got_off == $((off + offset)) && $got_max == $((max + offset)) ]] || { match=""; break; }
    done < "$(baseline_file)"
    [[ -n $match ]] && break
  done
  [[ -n $match ]] || match=custom
  printf '{"protocolVersion":%d,"curve":"%s"}\n' "$PROTOCOL_VERSION" "$match"
}

# ---- battery charge window -----------------------------------------------
# `charge limit <stop> <start>` records a window in charge.json; `charge tick`
# (run every 30 s by omarchy-fanctl-charge.timer, as root) enforces it with
# ectool chargecontrol: charging is disabled (idle — the laptop runs from AC)
# once the battery reaches <stop>, and stays disabled until it falls to
# <start>. Between the two the previous decision holds, so the pack never
# trickles. `charge off` removes the window and lets the EC charge normally.
power_root() { printf '%s\n' "${OMARCHY_FANCTL_POWER_ROOT:-$DEFAULT_POWER_ROOT}"; }
charge_file() { printf '%s/charge.json\n' "$(state_dir)"; }

read_charge_field() {
  local key=$1 text
  text=$(cat "$(charge_file)" 2>/dev/null) || return 1
  printf '%s' "$text" | grep -o "\"$key\":[^,}]*" | head -1 | sed 's/^"[^"]*"://; s/"//g'
}

write_charge() { # write_charge <enabled true|false> <stop> <start> <holding true|false>
  mkdir -p -- "$(state_dir)"
  local file; file=$(charge_file)
  printf '{"protocolVersion":%d,"enabled":%s,"stopPercent":%d,"startPercent":%d,"holding":%s,"updated":%d}\n' \
    "$PROTOCOL_VERSION" "$1" "$2" "$3" "$4" "$(date +%s)" > "$file.tmp"
  chmod 0644 "$file.tmp"
  mv -f "$file.tmp" "$file"
}

battery_percent() {
  local dir type value
  for dir in "$(power_root)"/*; do
    [[ -r $dir/type ]] || continue
    IFS= read -r type < "$dir/type" || continue
    [[ $type == Battery ]] || continue
    value=$(read_number "$dir/capacity") || continue
    printf '%s\n' "$value"
    return 0
  done
  return 1
}

cmd_charge_limit() {
  local stop=$1 start=$2
  [[ $stop =~ ^[0-9]+$ && $start =~ ^[0-9]+$ ]] || fail "stop and start must be integer percents"
  (( stop >= MIN_STOP && stop <= MAX_STOP )) || fail "stop must be between $MIN_STOP and $MAX_STOP"
  (( start >= MIN_START && start < stop )) || fail "start must be between $MIN_START and stop-1"
  require_root
  write_charge true "$stop" "$start" false
  cmd_charge_tick
}

cmd_charge_off() {
  local stop start
  require_root
  stop=$(read_charge_field stopPercent || true); [[ $stop =~ ^[0-9]+$ ]] || stop=99
  start=$(read_charge_field startPercent || true); [[ $start =~ ^[0-9]+$ ]] || start=85
  run_ectool chargecontrol normal >/dev/null
  write_charge false "$stop" "$start" false
  printf 'charge limit disabled\n'
}

cmd_charge_tick() {
  local stop start holding percent
  [[ $(read_charge_field enabled || true) == true ]] || return 0
  require_root
  stop=$(read_charge_field stopPercent) && [[ $stop =~ ^[0-9]+$ ]] || return 0
  start=$(read_charge_field startPercent) && [[ $start =~ ^[0-9]+$ ]] || return 0
  holding=$(read_charge_field holding || true)
  percent=$(battery_percent) || return 0
  if (( percent >= stop )); then holding=true
  elif (( percent <= start )); then holding=false
  fi
  [[ $holding == true ]] || holding=false
  if [[ $holding == true ]]; then run_ectool chargecontrol idle >/dev/null
  else run_ectool chargecontrol normal >/dev/null
  fi
  write_charge true "$stop" "$start" "$holding"
  printf 'battery %d%%: charging %s\n' "$percent" "$([[ $holding == true ]] && echo disabled || echo enabled)"
}

cmd_charge() {
  case ${1:-} in
    limit) [[ -n ${2:-} && -n ${3:-} ]] || fail "usage: omarchy-fanctl charge limit <stop> <start>"; cmd_charge_limit "$2" "$3" ;;
    off)   cmd_charge_off ;;
    tick)  cmd_charge_tick ;;
    *)     fail "usage: omarchy-fanctl charge <limit STOP START|off>" ;;
  esac
}

case ${1:-} in
  status)  cmd_status ;;
  auto)    cmd_auto ;;
  manual)  [[ -n ${2:-} ]] || fail "usage: omarchy-fanctl manual <10..100>"; cmd_manual "$2" ;;
  curve)   [[ -n ${2:-} ]] || fail "usage: omarchy-fanctl curve <stock|quiet|silent>"; cmd_curve "$2" ;;
  curves)  cmd_curves ;;
  charge)  shift; cmd_charge "$@" ;;
  version) printf 'omarchy-fanctl protocol %d\n' "$PROTOCOL_VERSION" ;;
  *)       printf 'usage: omarchy-fanctl <status|auto|manual 10..100|curve stock|quiet|silent|curves|charge limit STOP START|charge off|version>\n' >&2; exit 1 ;;
esac
